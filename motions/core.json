{
  "schema": 1,
  "id": "kwip-core",
  "name": "KWIP core motions",
  "version": "1.0.0",
  "author": "KWIP Animation",
  "motions": {
    "fade-in": {
      "label": "Fade in",
      "group": "Entrances",
      "kind": "entrance",
      "from": {
        "opacity": 0
      }
    },
    "fade-up": {
      "label": "Fade up",
      "group": "Entrances",
      "kind": "entrance",
      "from": {
        "opacity": 0,
        "y": "$distance"
      },
      "params": {
        "distance": {
          "type": "number",
          "label": "Distance",
          "default": 40,
          "min": 0,
          "max": 400,
          "step": 5,
          "unit": "px"
        }
      }
    },
    "fade-down": {
      "label": "Fade down",
      "group": "Entrances",
      "kind": "entrance",
      "from": {
        "opacity": 0,
        "y": "-$distance"
      },
      "params": {
        "distance": {
          "type": "number",
          "label": "Distance",
          "default": 40,
          "min": 0,
          "max": 400,
          "step": 5,
          "unit": "px"
        }
      }
    },
    "fade-left": {
      "label": "Fade left",
      "group": "Entrances",
      "kind": "entrance",
      "from": {
        "opacity": 0,
        "x": "$distance"
      },
      "params": {
        "distance": {
          "type": "number",
          "label": "Distance",
          "default": 40,
          "min": 0,
          "max": 400,
          "step": 5,
          "unit": "px"
        }
      }
    },
    "fade-right": {
      "label": "Fade right",
      "group": "Entrances",
      "kind": "entrance",
      "from": {
        "opacity": 0,
        "x": "-$distance"
      },
      "params": {
        "distance": {
          "type": "number",
          "label": "Distance",
          "default": 40,
          "min": 0,
          "max": 400,
          "step": 5,
          "unit": "px"
        }
      }
    },
    "scale-up": {
      "label": "Scale up",
      "group": "Effects",
      "kind": "effect",
      "to": {
        "scale": "$scale"
      },
      "legs": 2,
      "hold": true,
      "params": {
        "scale": {
          "type": "number",
          "label": "Scale",
          "default": 1.1,
          "min": 1,
          "max": 3,
          "step": 0.05,
          "unit": "x"
        }
      }
    },
    "scale-down": {
      "label": "Scale down",
      "group": "Effects",
      "kind": "effect",
      "to": {
        "scale": "$scale"
      },
      "legs": 2,
      "hold": true,
      "params": {
        "scale": {
          "type": "number",
          "label": "Scale",
          "default": 0.9,
          "min": 0.1,
          "max": 1,
          "step": 0.05,
          "unit": "x"
        }
      }
    },
    "pulse": {
      "label": "Pulse",
      "group": "Effects",
      "kind": "effect",
      "to": {
        "scale": "$scale"
      },
      "legs": 4,
      "params": {
        "scale": {
          "type": "number",
          "label": "Scale",
          "default": 1.12,
          "min": 1,
          "max": 3,
          "step": 0.02,
          "unit": "x"
        }
      }
    },
    "spin": {
      "label": "Spin",
      "group": "Effects",
      "kind": "effect",
      "to": {
        "rotation": "+=360"
      },
      "ease": "power2.inOut"
    },
    "flip-x": {
      "label": "Flip X",
      "group": "Effects",
      "kind": "effect",
      "to": {
        "rotationX": "+=360",
        "transformPerspective": 600
      },
      "ease": "power2.inOut"
    },
    "flip-y": {
      "label": "Flip Y",
      "group": "Effects",
      "kind": "effect",
      "to": {
        "rotationY": "+=360",
        "transformPerspective": 600
      },
      "ease": "power2.inOut"
    },
    "shake": {
      "label": "Shake",
      "group": "Effects",
      "kind": "effect",
      "keyframes": {
        "x": [
          -10,
          10,
          -8,
          8,
          -4,
          4,
          0
        ],
        "easeEach": "sine.inOut"
      }
    }
  }
}